# Hy3 endpoint configuration. Copy this file to .env and fill in the three
# required values locally. Never commit the real .env file.
HY3_BASE_URL=https://replace-with-your-hy3-endpoint/v1
HY3_MODEL=hy3
HY3_API_KEY=


# Local mutable state. These paths are ignored by Git.
WORKBENCH_DATA_DIR=.local/workbench
HARBOR_JOBS_DIR=.local/harbor/jobs

# Local development servers.
WORKBENCH_HOST=127.0.0.1
WORKBENCH_PORT=8000
VITE_API_PROXY_TARGET=http://127.0.0.1:8000
