#!/usr/bin/env bash
set -euo pipefail

script_dir="$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)"
project_dir="$(dirname -- "$script_dir")"

export UV_CACHE_DIR="$project_dir/.local/uv/cache"
export UV_PYTHON_INSTALL_DIR="$project_dir/.local/uv/python"
export UV_PYTHON_BIN_DIR="$project_dir/.local/uv/bin"
export MSWEA_GLOBAL_CONFIG_DIR="$project_dir/.local/mini-swe-agent"

cd "$project_dir"
exec uv "$@"
